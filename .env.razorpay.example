# ──────────────────────────────────────────────────────────────
# Razorpay Payment Gateway
# Sign up at https://razorpay.com and copy your keys from the
# Dashboard → Settings → API Keys section.
#
# Use TEST keys during development (prefix: rzp_test_)
# Use LIVE keys in production  (prefix: rzp_live_)
# ──────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
